# Copy this file to .env for local development (.env is gitignored).
# Deployed environments set ZH_API_BASE_URL as a variable at build time instead of using a .env file.
# Absolute http(s) URL of the API, including the /api prefix. Leave empty to call the API on the
# app's own origin (`<origin>/api`).
ZH_API_BASE_URL=http://localhost:5336/api
