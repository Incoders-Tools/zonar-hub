{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git branch -D *)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(rm -rf *)",
      "PowerShell(Remove-Item * -Recurse -Force*)"
    ],
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write"
    ]
  }
}